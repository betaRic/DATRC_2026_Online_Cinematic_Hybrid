const S=[{"id":1,"title":"Drug Abuse Prevention<br>&amp; Control Week <em>2026</em>","sub":"DOH–SOCCSKSARGEN Drug Abuse Treatment and Rehabilitation Center","cue":"a pleasant morning to everyone","accent":"#8be9d4","image":"datrc_front","montage":[],"kind":"full","section":"Opening","speech":["Dr. Imelda K Quiñones, Chief of Hospital of SOCCSKSARGEN DATRC","All DATRC Officials","Representatives of various national government agencies","Punong Barangays","BADAC members","Partners in public service","Distinguished guests, ladies and gentlemen, a pleasant morning to everyone!","Isang malaking karangalan po para sa akin ang makasama kayo ngayong araw na ito and be part of this year's Drug Abuse Prevention and Control Week celebration."],"pids":[2,3,4,5,6,7,8,9],"media":["datrc_front"],"layout":"hero","duration":8500,"tag":"WELCOME"},{"id":2,"title":"A center of healing.<br><em>A place of hope.</em>","sub":"Pagpupugay sa dedikasyon ng DOH–SOCCSKSARGEN DATRC","cue":"una sa lahat","accent":"#ffce8e","image":"datrc_archival","montage":[],"kind":"full","section":"Gratitude","speech":["Una sa lahat, nais ko pong ipaabot ang aking taos-pusong pasasalamat sa pamunuan at buong staff ng DOH-SOCCSKSARGEN Drug Abuse Treatment and Rehabilitation Center—hindi lamang po sa mainit na pag-imbita sa amin ngayon, kundi pati na rin po sa inyong walang-sawang dedikasyon sa paggamot, rehabilitasyon, at pagbibigay ng bagong pag-asa sa ating mga kababayan."],"pids":[10],"media":["datrc_side"],"layout":"framed","duration":8500,"tag":""},{"id":3,"title":"<em>Nagkakaisang</em><br>Pamilya at Pamayanan","sub":"Laban sa Ilegal na Droga para sa Ligtas at Malusog na Kinabukasan","cue":"this year’s theme","accent":"#a2e3ff","image":"gensan_aerial_new","montage":[],"kind":"full","section":"2026 Theme","speech":["This year’s theme, “Nagkakaisang Pamilya at Pamayanan Laban sa Ilegal na Droga para sa Ligtas at Malusog na Kinabukasan,” carries a clear and urgent truth: winning the fight against illegal drugs cannot rest on the shoulders of a single agency. It demands a whole-of-nation, whole-of-community response—anchored on the strength of every Filipino family and the vigilance of every neighborhood."],"pids":[11],"media":["gensan_street"],"layout":"hero","duration":8500,"tag":""},{"id":4,"title":"Sa tahanan nagsisimula<br>ang <em>tamang gabay.</em>","sub":"Kaalaman, gabay, at pag-uusap na nagsisimula sa tahanan.","cue":"sa ating kultura","accent":"#ffe3af","image":"family_community_support","montage":[],"kind":"full","section":"Family","speech":["Sa ating kultura, ang pamilya ang ating unang takbuhan at pinakamatibay na kanlungan. Ngunit kapag may isang miyembro ng pamilya na naliligaw ng landas, hindi lamang siya ang nasasaktan—buong tahanan ang nagdurusa. That is why our defense must start around the dining table, in open conversations between parents and children, and in neighborhoods that choose to look out for one another rather than look away."],"pids":[12],"media":["family_community_support"],"layout":"framed","duration":8500,"tag":""},{"id":5,"title":"Matatag ang pamilya.<br><em>Matatag ang barangay.</em>","sub":"Communities grow stronger when neighbors stand together.","cue":"kapag matatag ang pamilya","accent":"#bce5de","image":"community_together","montage":[],"kind":"full","section":"Family & Community","speech":["Kapag matatag ang pamilya, matatag ang barangay; at kapag nagkakaisa ang pamayanan, walang puwang ang ilegal na droga."],"pids":[13],"media":["neighborhood_support","community_together"],"layout":"hero","duration":8500,"tag":""},{"id":6,"title":"Ang barangay ang tunay<br>na <em>frontliners.</em>","sub":"Visible leadership. Early action. Community support.","cue":"kinikilala po","accent":"#b9eaff","image":"barangay_volunteers","montage":[],"kind":"full","section":"Barangays & BADACs","speech":["Kinikilala po ng Department of the Interior and Local Government na ang ating mga barangay ang tunay na frontliners sa adbokasiyang ito.","Sa ating mga Punong Barangays at Barangay Anti-Drug Abuse Councils (BADACs): your leadership on the ground is what turns national policy into real, lasting protection for our people. Kayo ang unang nakakaalam kung may problema sa komunidad, at kayo rin ang unang nakakapag-abot ng tulong bago pa lumala ang sitwasyon.","When our BADACs are active, visible, and proactive, we do not just enforce the law—we build safe neighborhoods where families feel secure and supported."],"pids":[14,16,17],"media":["barangay_volunteers","barangay_council_session","forum"],"layout":"framed","duration":8500,"tag":""},{"id":7,"title":"<em>Tatlong haligi.</em><br>Iisang layunin.","sub":"Prevention   ·   Collaboration   ·   Recovery","cue":"three vital pillars","accent":"#e8dec8","image":null,"montage":[],"kind":"pillars-overview","section":"Three Pillars","speech":["And as we move forward together, let me emphasize three vital pillars of our shared mission:"],"pids":[18],"media":[],"layout":"trio","duration":8500,"tag":"THREE VITAL PILLARS"},{"id":8,"title":"<em>First.</em><br>Anchor prevention<br>in the home and<br>the community.","sub":"Open conversations. Early guidance. Stronger youth.","cue":"first, anchor prevention","accent":"#9addfa","image":"students","montage":[],"kind":"pillar","section":"Pillar 1 — Prevention","speech":["First, anchor prevention in the home and the community. Ang pinakamatibay nating depensa ay ang maagang kaalaman at tamang gabay. We must empower our children and youth with the knowledge and resilience to reject illegal drugs.","When families, schools, and barangays stand together to guide the next generation, we stop drug abuse before it even begins."],"pids":[19,20],"media":["joint_mission_children","students"],"layout":"framed","duration":8500,"tag":"PILLAR 01"},{"id":9,"title":"<em>Second.</em><br>Deepen inter-agency<br>collaboration and<br>grassroots action.","sub":"Agencies, barangays, and communities acting together.","cue":"second, deepen","accent":"#b0f6ca","image":"forum","montage":[],"kind":"pillar","section":"Pillar 2 — Collaboration","speech":["Second, deepen inter-agency collaboration and grassroots action. The campaign against illegal drugs requires the continued cooperation of the various national government agencies, local government units, barangays, civil society organizations and other stakeholders.","Let us all ensure that our BADACs remain functional and that our programs translate into meaningful actions and positive results."],"pids":[21,22],"media":["multi_agency_roundtable","interagency_briefing","meeting_speaker","public_service_training"],"layout":"framed","duration":7300,"tag":"PILLAR 02"},{"id":10,"title":"<em>Third.</em><br>Champion compassion,<br>rehabilitation, and<br>reintegration.","sub":"Treatment. Rehabilitation. Reintegration.","cue":"third, champion compassion","accent":"#ffd4a7","image":"datrc_side","montage":[],"kind":"pillar","section":"Pillar 3 — Recovery","speech":["Third, champion compassion, rehabilitation, and reintegration. Enforcement alone will never be enough. We must also provide opportunities for treatment, rehabilitation, and reintegration.","Individuals recovering from substance abuse deserve guidance, understanding, and a second chance to become productive members of the society."],"pids":[23,24],"media":["datrc_archival"],"layout":"hero","duration":8500,"tag":"PILLAR 03"},{"id":11,"title":"Saludo kami sa<br><em>tapang ninyo.</em>","sub":"Recovery deserves dignity, privacy, and a second chance.","cue":"sa ating mga kapatid","accent":"#ffd89e","image":null,"montage":[],"kind":"interlude","section":"Courage","speech":["Sa ating mga kapatid na nagpapagaling dito ngayon: saludo kami sa tapang ninyo. Hindi madali ang humingi ng tulong at magsimula muli, pero pinili ninyo ang tama."],"pids":[25],"media":[],"layout":"interlude","duration":8500,"tag":""},{"id":12,"title":"With open arms.<br><em>Not judgment.</em>","sub":"Salubungin nang may pag-unawa at malasakit.","cue":"and to our communities","accent":"#facaa9","image":"volunteers","montage":[],"kind":"full","section":"Reintegration","speech":["And to our communities, let us welcome them back with open arms - not judgment. Salubungin natin sila ng may pang-unawa at handang umalalay habang binubuo nila muli ang kanilang buhay."],"pids":[26],"media":["relief_team_mobilization","collaboration_team"],"layout":"framed","duration":8000,"tag":""},{"id":13,"title":"Youth in school.<br>Families healed.<br><em>Lives rebuilt.</em>","sub":"BIDA — Buhay Ingatan, Droga’y Ayawan","cue":"to our local leaders","accent":"#b9ffbd","image":"community_event","montage":[],"kind":"full","section":"Real Outcomes","speech":["To our local leaders and BADAC members: let us measure our success not merely by the number of reports submitted or meetings convened, but by the number of youth kept in school, the number of families healed, and the number of recovering persons who successfully reintegrated into our communities without fear of discrimination.","Ang tunay na tagumpay ng Buhay Ingatan, Droga'y Ayawan (BIDA) program ay makikita sa bawat buhay na naisalba at bawat pangarap na muling nabuo."],"pids":[28,29],"media":["volunteers","local_leaders_united"],"layout":"hero","duration":8200,"tag":""},{"id":14,"title":"A drug-free community<br>is built with <em>compassion.</em>","sub":"Education · Accountable leadership · Strong partnerships","cue":"ladies and gentlemen, a drug-free community","accent":"#ded4ff","image":"community_assembly","montage":[],"kind":"full","section":"Communities of Care","speech":["Ladies and gentlemen, a drug-free community is not built by fear or force alone. It is built through education, accountable leadership, strong partnerships, and above all, compassion.","Let us therefore move beyond commitments and continue working together to protect our families, empower our youth, and build safer and healthier communities."],"pids":[30,31],"media":["community_assembly","community_event","large_partner_forum"],"layout":"hero","duration":7600,"tag":""},{"id":15,"title":"Hindi sapat ang salita.<br><em>Kilos ang kailangan.</em>","sub":"Dapat maramdaman sa bawat tahanan, paaralan, at barangay.","cue":"hindi sapat na hanggang salita","accent":"#b4dffb","image":null,"montage":[],"kind":"interlude","section":"From Words to Action","speech":["Hindi sapat na hanggang salita o pirmadong kasunduan lang ang ating adbokasiya—dapat itong maramdaman sa bawat tahanan, paaralan, at barangay.","Whether you are a parent guiding your child, a barangay leader keeping watch over your neighborhood, or a partner agency extending a helping hand, every small, consistent action counts. Kapag lahat tayo ay kumikilos, mas nagiging matatag ang ating depensa laban sa ilegal na droga.","On behalf of the Department of the Interior and Local Government, I reaffirm our steadfast commitment to equipping and supporting our LGUs and barangays as we strengthen our anti-illegal drug initiatives across the region."],"pids":[32,33,34],"media":["joint_community_response","ground_level_outreach"],"layout":"framed","duration":7800,"tag":""},{"id":16,"title":"<em>Sama-sama</em> nating labanan.<br><em>Sama-sama</em> nating protektahan.","sub":"Para sa isang ligtas, malusog, at drug-free na pamayanan.","cue":"sama-sama nating labanan","accent":"#e6d1ff","image":"gensan_street","montage":[],"kind":"full","section":"United","speech":["Sama-sama nating labanan ang ilegal na droga. Sama-sama nating protektahan ang ating mga pamilya. At sama-sama nating itaguyod ang isang ligtas, malusog, at drug-free na pamayanan!","Maraming salamat po, at patuloy tayong magkaisa para sa isang mas ligtas at mas maunlad na Bagong Pilipinas."],"pids":[35,36],"media":["partnership_group","community_partners_together"],"layout":"hero","duration":8200,"tag":""},{"id":17,"title":"Mabuhay ang ating<br><em>mga barangay!</em><br>Mabuhay ang Pilipinas!","sub":"","cue":"mabuhay ang ating mga barangay","accent":"#ffe4aa","image":null,"montage":[],"kind":"final","section":"Closing","speech":["Mabuhay ang ating mga barangay! Mabuhay ang Pilipinas!"],"pids":[37],"media":["gensan_aerial_new"],"layout":"final","duration":8500,"tag":"CLOSING"}];
