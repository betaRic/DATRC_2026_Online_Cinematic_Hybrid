function directorApply(){transitionStyle=$('#transitionSelect').value;cameraPreset=$('#motionSelect').value;rollInterval=Number($('#speedRange').value);$('#speedValue').textContent=rollInterval;showFilmstrip=$('#filmstripCheck').checked;repeatRoll=$('#loopCheck').checked;updateFilmstrip();schedule();}
window.addEventListener('load',()=>{enableGSAP();updateEngine()});const gScript=$('#gsapCdn');if(gScript){gScript.addEventListener('load',enableGSAP);gScript.addEventListener('error',updateEngine);}updateEngine();

function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
const plainTitle=s=>s.replace(/<br\s*\/?\s*>/gi,' · ').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&');
function sleep(n){return new Promise(resolve=>setTimeout(resolve,n));}
function loadImage(key){
 if(!key)return Promise.reject(Error('No image'));
 if(imageCache.has(key))return Promise.resolve(imageCache.get(key));
 if(loading.has(key))return loading.get(key);
 const ref=MEDIA[key];if(!ref)return Promise.reject(Error('Unknown image '+key));
 const image=new Image();image.decoding='async';image.src=new URL(ref.file,document.baseURI).href;
 const work=(image.decode?image.decode():new Promise((res,rej)=>{image.onload=res;image.onerror=rej})).then(()=>{imageCache.set(key,image);return image}).finally(()=>loading.delete(key));
 loading.set(key,work);return work;
}
function warmNearby(){
 const keys=[...S[scene].media,...(S[scene+1]?.media||[])];
 let i=0;const warm=()=>{if(i>=keys.length)return;loadImage(keys[i++]).catch(()=>{});if('requestIdleCallback' in window)requestIdleCallback(warm,{timeout:1200});else setTimeout(warm,75)};
 if('requestIdleCallback' in window)requestIdleCallback(warm,{timeout:700});else setTimeout(warm,100);
}
function presentImage(key){
 const token=++photoToken;
 if(!key){for(const el of $$('.mediaImage'))el.classList.remove('active');return}
 loadImage(key).then(image=>{
  if(token!==photoToken)return;
  const frames=$$('.mediaImage'),incoming=frames[1-activeSlot],outgoing=frames[activeSlot],cfg=MEDIA[key];
  incoming.style.setProperty('--focus',cfg.pos);incoming.style.setProperty('--zoom',String(1+cfg.zoom));
  incoming.style.setProperty('--drift-x',cfg.dx);incoming.style.setProperty('--drift-y',cfg.dy);
  incoming.src=image.src;incoming.alt=cfg.alt;
  if(gsapReady&&!reducedMotion.matches&&motion){
   const g=window.gsap;g.killTweensOf(incoming);g.killTweensOf(outgoing);
   const firstFrame=!outgoing.getAttribute('src');const dur=transitionStyle==='soft'?1.15:.92;
   const lateral=transitionStyle==='slide'?(scene%2?5:-5):1.2;
   const startScale=transitionStyle==='soft'?1.04:(cameraPreset==='dramatic'?1.14:1.095);
   g.set(incoming,{opacity:0,scale:startScale,xPercent:lateral,yPercent:0});incoming.classList.add('active');
   if(!firstFrame){g.to(outgoing,{opacity:0,scale:1.018,xPercent:-lateral*.5,duration:dur,ease:'power2.inOut',overwrite:true,onComplete:()=>{if(token===photoToken)outgoing.classList.remove('active')}})}else outgoing.classList.remove('active');
   g.to(incoming,{opacity:1,scale:1.04,xPercent:0,duration:dur,ease:'power3.out',overwrite:true,onComplete:()=>{
    if(token!==photoToken||!motion)return;
    const factor=cameraPreset==='dramatic'?1.7:cameraPreset==='subtle'?.55:1;
    photoMotionTween=g.to(incoming,{scale:1.04+cfg.zoom*factor,xPercent:parseFloat(cfg.dx)*factor,yPercent:parseFloat(cfg.dy)*factor,duration:cameraPreset==='dramatic'?17:25,ease:'none',overwrite:false});
   }});
   activeSlot=1-activeSlot;
  }else{
   incoming.style.opacity='';incoming.style.transform='';outgoing.style.opacity='';outgoing.style.transform='';
   requestAnimationFrame(()=>{if(token!==photoToken)return;incoming.classList.add('active');outgoing.classList.remove('active');activeSlot=1-activeSlot;});
  }
  updateFilmstripActive();
 }).catch(()=>{});
}
function stopTimer(){if(timer){clearTimeout(timer);timer=null}}
function schedule(){stopTimer();const s=S[scene];if(!montage||!motion||s.media.length<2||reducedMotion.matches)return;
 if(frameIndex>=s.media.length-1&&!repeatRoll)return;
 timer=setTimeout(()=>{frameIndex=(frameIndex+1)%s.media.length;presentImage(s.media[frameIndex]);schedule();updateOperatorImage()},rollInterval*1000);
}
function nextPhoto(direction){const s=S[scene];if(!s.media.length)return;frameIndex=Math.max(0,Math.min(s.media.length-1,frameIndex+direction));presentImage(s.media[frameIndex]);schedule();updateOperatorImage()}
let first=true;function navigate(index){
 const next=Math.min(S.length-1,Math.max(0,Number(index)||0));if(!first&&next===scene)return;
 first=false;scene=next;frameIndex=0;const s=S[scene],stage=$('#stage');
 stopTimer();document.documentElement.style.setProperty('--accent',s.accent||'#9ae8db');stage.dataset.layout=s.layout==='trio'?'trio':s.layout==='interlude'?'interlude':s.layout==='final'?'final':s.layout==='framed'?'framed':s.kind==='pillar'?'pillar':'hero';
 if(s.kind==='pillar'&&s.layout!=='framed')stage.dataset.layout='pillar';
 $('#eyebrow').textContent=s.tag||'';$('#title').innerHTML=s.title;$('#subtitle').textContent=s.sub||'';$('#subtitle').style.display=s.sub?'block':'none';
 const num=scene===7?'01':scene===8?'02':scene===9?'03':'';$('#pillarNumber').textContent=num;
 const copy=$('#copy');copy.classList.remove('enter');requestAnimationFrame(()=>copy.classList.add('enter'));
 $('#count').textContent=String(scene+1).padStart(2,'0')+' / '+S.length;$('#progressFill').style.width=((scene+1)*100/S.length)+'%';
 stage.classList.remove('sceneChange');requestAnimationFrame(()=>{stage.classList.add('sceneChange');if(gsapReady)animateSceneCopy()});
 updateFilmstrip();presentImage(s.media[0]);schedule();warmNearby();renderNotes();renderOperator();updateOperatorImage();
 if(operatorWindow&&!operatorWindow.closed)try{operatorWindow.postMessage({type:'state',scene},'*')}catch{}
 document.title='DATRC 2026 • '+s.section;
}
function updateOperatorImage(){const el=$('#opPhotoState');if(el){const s=S[scene];el.textContent=s.media.length?'PHOTO '+(frameIndex+1)+' / '+s.media.length+' · '+s.media[frameIndex].replaceAll('_',' '):'ABSTRACT VISUAL'}}
function renderNotes(){if(!notesVisible)return;const s=S[scene];$('#noteHeading').textContent=s.section;$('#noteCue').textContent='Listen for: '+s.cue;$('#noteText').innerHTML=s.speech.map(p=>'<p>'+escapeHtml(p)+'</p>').join('')}
function renderOperator(){if(!isOperator)return;const s=S[scene];$('#opTitle').innerHTML=s.title;$('#opCue').textContent='ADVANCE ON: “'+s.cue+'”';$('#opScript').innerHTML=s.speech.map(p=>'<p>'+escapeHtml(p)+'</p>').join('');$('#opStatusText').textContent='SCENE '+String(scene+1).padStart(2,'0')+' OF '+S.length;$('#opNext').textContent=scene+1<S.length?'NEXT: “'+S[scene+1].cue+'” · '+S[scene+1].section:'LAST SCENE · HOLD FOR APPLAUSE';$$('.opScene').forEach((b,i)=>b.classList.toggle('active',i===scene));}
function sendScene(next){if(isOperator&&window.opener&&!window.opener.closed)window.opener.postMessage({type:'navigate',next},'*');navigate(next)}
function showTools(pin){if(document.body.classList.contains('ui-hidden')||isOperator)return;document.body.classList.add('ui-visible');clearTimeout(uiTimer);if(pin){document.body.classList.add('ui-pinned');return}if(!document.body.classList.contains('ui-pinned'))uiTimer=setTimeout(()=>document.body.classList.remove('ui-visible'),1700)}
function hideTools(){clearTimeout(uiTimer);document.body.classList.remove('ui-visible','ui-pinned')}
function toggleUI(){if(document.body.classList.contains('ui-hidden')){document.body.classList.remove('ui-hidden');showTools(true)}else if(document.body.classList.contains('ui-pinned')){hideTools()}else{showTools(true)}}
function setHardHide(){document.body.classList.toggle('ui-hidden');hideTools()}
function toggleMotion(){motion=!motion;$('#stage').classList.toggle('paused',!motion);if(gsapReady){window.gsap.globalTimeline.paused(!motion)}schedule();syncButtons()}
function toggleMontage(){montage=!montage;schedule();syncButtons()}
function syncButtons(){$('#btnMotion').classList.toggle('on',motion);$('#btnMontage').classList.toggle('on',montage);$('#btnImage').classList.toggle('on',heroOnly)}
function toggleImageOnly(){heroOnly=!heroOnly;$('#stage').classList.toggle('imageOnly',heroOnly);syncButtons()}
function toggleBlackout(){blackout=!blackout;$('#stage').classList.toggle('blackout',blackout)}
function notesToggle(force){notesVisible=(typeof force==='boolean'?force:!notesVisible);$('#notes').classList.toggle('open',notesVisible);renderNotes()}
function guideToggle(force){$('#guide').classList.toggle('open',typeof force==='boolean'?force:!$('#guide').classList.contains('open'))}
async function fullScreen(){try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen({navigationUI:'hide'})}catch(e){$('#launchHint').textContent='This browser preview blocks fullscreen. Open the extracted HTML file directly in Chrome or Edge.'}}
function begin(mode){$('#launcher').classList.add('hide');stageStarted=true;hideTools();updateFilmstrip();if(mode==='full')fullScreen()}
function openOperator(){if(operatorWindow&&!operatorWindow.closed){operatorWindow.focus();return}operatorWindow=window.open(location.href.split('?')[0]+'?operator=1','DATRC_2026_CUES','width=1200,height=820,scrollbars=yes,resizable=yes');if(!operatorWindow)guideToggle(true)}
window.addEventListener('message',e=>{if(isOperator){if(e.source!==window.opener)return;if(e.data?.type==='state')navigate(e.data.scene)}else if(operatorWindow&&e.source===operatorWindow){if(e.data?.type==='navigate')navigate(e.data.next);if(e.data?.type==='ready')operatorWindow.postMessage({type:'state',scene},'*')} });
function install(){
 if(isOperator){document.body.classList.add('operator');$('#opScenes').innerHTML=S.map((s,i)=>'<button class="opScene" data-index="'+i+'"><b>'+String(i+1).padStart(2,'0')+'</b>'+escapeHtml(s.section)+'</button>').join('');$('#opScenes').addEventListener('click',e=>{const b=e.target.closest('[data-index]');if(b)sendScene(+b.dataset.index)});$('#opPrev').onclick=()=>sendScene(scene-1);$('#opNextBtn').onclick=()=>sendScene(scene+1);navigate(0);if(window.opener)window.opener.postMessage({type:'ready'},'*');return}
 $('#btnDirector').onclick=()=>toggleDirector(true);$('#btnCustomize').onclick=()=>toggleDirector(true);$('#btnDirectorClose').onclick=()=>toggleDirector(false);$('#btnDirectorDone').onclick=()=>{directorApply();toggleDirector(false)};$('#speedRange').oninput=()=>{$('#speedValue').textContent=$('#speedRange').value};$('#director').addEventListener('click',e=>{if(e.target===$('#director'))toggleDirector(false)});$('#btnStart').onclick=()=>begin('full');$('#btnWindowed').onclick=()=>begin('window');$('#btnPrev').onclick=()=>navigate(scene-1);$('#btnNext').onclick=()=>navigate(scene+1);$('#btnMotion').onclick=toggleMotion;$('#btnMontage').onclick=toggleMontage;$('#btnImage').onclick=toggleImageOnly;$('#btnNotes').onclick=()=>notesToggle();$('#btnOperator').onclick=openOperator;$('#btnFullscreen').onclick=fullScreen;$('#btnMore').onclick=()=>guideToggle(true);$('#btnNotesClose').onclick=()=>notesToggle(false);$('#btnGuideClose').onclick=()=>guideToggle(false);
 $('#hotspot').addEventListener('pointerenter',()=>showTools());$('#hotspot').addEventListener('click',()=>showTools(true));
 $('#stage').addEventListener('click',e=>{if(!stageStarted||notesVisible||$('#guide').classList.contains('open'))return;const x=e.clientX/innerWidth; if(x<.14)navigate(scene-1); else if(x>.87)navigate(scene+1)});
 $('#toolbar').addEventListener('pointerenter',()=>showTools(true));$('#toolbar').addEventListener('pointerleave',()=>{document.body.classList.remove('ui-pinned');hideTools()});
 window.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&$('#director').classList.contains('open')){toggleDirector(false);return;}
  if(['INPUT','TEXTAREA','SELECT'].includes(e.target?.tagName)&&e.key!=='Escape')return;
  if(!stageStarted){if(e.key==='Enter'){e.preventDefault();begin('full')}return}
  if(e.key==='Escape'){guideToggle(false);notesToggle(false);return}
  if($('#director').classList.contains('open')){if(e.key==='Escape')toggleDirector(false);return;}if($('#guide').classList.contains('open'))return;
  if(['ArrowRight','ArrowDown',' ','PageDown'].includes(e.key)){e.preventDefault();if(!e.repeat)navigate(scene+1)}
  else if(['ArrowLeft','ArrowUp','PageUp'].includes(e.key)){e.preventDefault();if(!e.repeat)navigate(scene-1)}
  else if(e.key==='u'||e.key==='U')toggleUI();else if(e.key==='d'||e.key==='D')toggleDirector();else if(e.key==='r'||e.key==='R'){showFilmstrip=!showFilmstrip;$('#filmstripCheck').checked=showFilmstrip;updateFilmstrip();}
  else if(e.key==='h'||e.key==='H')setHardHide();
  else if(e.key==='p'||e.key==='P')toggleMotion();
  else if(e.key==='m'||e.key==='M')toggleMontage();
  else if(e.key==='i'||e.key==='I')toggleImageOnly();
  else if(e.key==='b'||e.key==='B')toggleBlackout();
  else if(e.key==='o'||e.key==='O')openOperator();
  else if(e.key==='n'||e.key==='N')notesToggle();
  else if(e.key==='f'||e.key==='F')fullScreen();
  else if(e.key==='.'||e.key==='>')nextPhoto(1);
  else if(e.key===','||e.key==='<')nextPhoto(-1);
  else if(e.key==='?'||e.key==='/')guideToggle(true);
  else if(e.key==='Home')navigate(0);else if(e.key==='End')navigate(S.length-1);
 });
 $('#guide').addEventListener('click',e=>{if(e.target===$('#guide'))guideToggle(false)});
 $('#trio').innerHTML=[['01','PREVENTION','Home & community'],['02','COLLABORATION','Agencies & grassroots'],['03','RECOVERY','Compassion & reintegration']].map(([n,label,small])=>'<div class="pillarCard"><b>'+n+'</b><span>'+label+'<small style="display:block;opacity:.65;font-weight:500;margin-top:5px">'+small+'</small></span></div>').join('');
 syncButtons();navigate(0);setTimeout(enableGSAP,0);
}
install();
</script></body></html>
